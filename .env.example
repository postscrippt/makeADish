# Copy to .env.local. Never commit real keys.

# true = the whole UI runs on mock data with no keys (mocks/api.ts)
NEXT_PUBLIC_USE_MOCKS=true

LLM_PROVIDER=gemini
LLM_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_KEY=

# LIFF app id from the LINE Developers console (LINE Login channel). Empty = LINE features stay off.
# Enables "send recipe to chat", share and back-to-chat when pages are opened inside LINE. See docs/line-chat-flow.md.
NEXT_PUBLIC_LIFF_ID=

# LINE Messaging API (server-only, for the webhook in app/api/line/webhook). Never expose to the browser.
# Channel ID of the LINE Login channel that owns the LIFF app (a number, not a secret). Server-only.
# Used to verify the LIFF ID token when a profile is saved inside LINE, which links it to the chat.
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public base URL used in chat buttons when NEXT_PUBLIC_LIFF_ID is empty. Defaults to the Vercel deployment.
APP_URL=
